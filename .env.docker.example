# Docker Compose 部署环境变量示例
# 使用方式：
# 1. 复制本文件为 .env.docker
# 2. 按你的服务器环境修改下面的值
# 3. 再执行 docker compose up -d --build
#
# 注意：
# - 本文件中的密码、密钥、数据库名都只是“示例占位值”，不能直接用于生产环境
# - 凡是带有“请修改”说明的字段，部署前都应该改成你自己的真实值

# ==================== 应用基础配置 ====================

# 运行环境标识。
# 当前 Docker 部署默认走生产环境配置，因此这里通常保持 prod 即可。
ENV=prod

# 业务环境名称。
# 对应 app/core/config.py 中的环境映射逻辑，生产部署通常写 production。
ENVIRONMENT=production

# API 路由前缀。
# 当前项目默认使用 /api/v1，除非你同步改了后端路由设计，否则不要随意修改。
API_PREFIX=/api/v1

# API 版本号。
# 当前项目统一使用 1。
VERSION=1

# 是否开启调试模式。
# 生产环境请保持 False，避免暴露过多调试信息。
DEBUG=False

# Docker 部署时使用哪一个应用环境文件。
# 可选值示例：
# - .env.production
# - .env.development
# - .env.test
#
# 说明：
# - 这个值决定 backend 服务最终注入哪套应用配置；
# - 生产部署通常填写 .env.production；
# - 如果服务器只是跑测试环境，可以改成 .env.test；
# - 对应文件需要真实存在于服务器项目目录中。
KM_APP_ENV_FILE=.env.production


# ==================== JWT 鉴权配置 ====================

# JWT 签名密钥。
# 请修改：必须换成你自己的长随机字符串，不能使用示例值。
SECRET_KEY=please-change-to-a-long-random-secret-key

# JWT 算法。
# 当前项目默认使用 HS256，除非你同步修改鉴权实现，否则保持不变。
ALGORITHM=HS256

# Token 过期时间（分钟）。
# 10080 = 7 天，可按业务要求调整。
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ==================== 后端数据库连接配置 ====================

# SQLAlchemy 数据库驱动。
# 当前项目 MySQL 默认使用 mysqlconnector。
DB_DRIVER=mysql+mysqlconnector

# 数据库主机名。
# 使用 docker-compose 时，后端连接 mysql 服务应填写 mysql。
DB_HOST=mysql

# 数据库端口。
DB_PORT=3306

# 数据库名称。
# 请修改：建议按你的环境命名，例如 login_km_system_prod。
DB_NAME=please_change_db_name

# 数据库用户名。
# 请修改：建议不要直接使用 root，而是使用独立业务账号。
DB_USER=please_change_db_user

# 数据库密码。
# 请修改：必须换成你自己的数据库密码。
DB_PASSWORD=please_change_db_password

# 数据库字符集。
DB_CHARSET=utf8mb4

# 是否打印 SQL。
# 生产环境建议保持 False。
DB_ECHO=False

# 数据库连接池大小。
DB_POOL_SIZE=10

# 连接池最大额外连接数。
DB_MAX_OVERFLOW=20

# 连接回收时间（秒）。
DB_POOL_RECYCLE=3600

# 连接池获取超时时间（秒）。
DB_POOL_TIMEOUT=30


# ==================== MySQL 容器初始化配置 ====================

# MySQL root 密码。
# 请修改：必须换成你自己的强密码。
MYSQL_ROOT_PASSWORD=please_change_mysql_root_password

# MySQL 初始化数据库名。
# 通常与上面的 DB_NAME 保持一致。
MYSQL_DATABASE=please_change_db_name

# MySQL 初始化业务账号用户名。
# 通常与上面的 DB_USER 保持一致。
MYSQL_USER=please_change_db_user

# MySQL 初始化业务账号密码。
# 通常与上面的 DB_PASSWORD 保持一致。
MYSQL_PASSWORD=please_change_db_password


# ==================== 时区配置 ====================

# 容器时区。
# 默认使用 Asia/Shanghai，可按服务器所在地区调整。
TZ=Asia/Shanghai


# ==================== Docker 可选代理配置 ====================

# 这四项是“可选配置”，不是必填项。
#
# 使用规则：
# 1. 如果你的 Linux 服务器访问 Docker Hub、PyPI、npm 仓库需要代理，再填写它们
# 2. 如果你的服务器根本不需要代理，请保持为空
# 3. 本地开发或本地 Docker 测试如果不填写，也不会影响原有无代理构建流程

# 可选：HTTP 代理地址。
# 示例：http://127.0.0.1:8118
# 无代理服务器请留空。
KM_DOCKER_HTTP_PROXY=

# 可选：HTTPS 代理地址。
# 常见情况下与 HTTP 代理保持一致。
# 无代理服务器请留空。
KM_DOCKER_HTTPS_PROXY=

# 可选：全局代理地址。
# 常见于 socks5 代理，例如：socks5://127.0.0.1:1080
# 如果没有这类代理，请留空。
KM_DOCKER_ALL_PROXY=

# 可选：代理白名单。
# 建议至少保留 localhost、127.0.0.1、::1、mysql，
# 避免容器访问本机服务和数据库服务时误走代理。
KM_DOCKER_NO_PROXY=localhost,127.0.0.1,::1,mysql


# ==================== 默认数据初始化配置 ====================

# 是否在首次启动时自动初始化默认数据。
# true 时会自动创建：
# - 默认应用 default_app
# - 管理员账号 admin / admin123456
# - 测试账号 testuser / test123456
#
# 仅建议测试环境开启，生产环境建议保持 false。
KM_AUTO_INIT_DATA=false

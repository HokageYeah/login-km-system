# 通用环境变量示例
# 使用方式：
# 1. 复制为某个真实环境文件，例如 .env.development / .env.production / .env.test
# 2. 或者先复制为 .env，再通过 ENV 指定当前默认加载哪个环境文件
# 3. 再把下面的示例占位值替换成你自己的真实配置
#
# 注意：
# - 当前项目真正读取的是 DB_*、SECRET_KEY、API_PREFIX 这一类“通用字段”
# - .env.development / .env.production / .env.test 也是使用同一套字段，只是值不同
# - 因此这里给出的是单环境模板，而不是 DEV_DB_* / PROD_DB_* / TEST_DB_* 三套旧结构

# 环境选择字段
# 常见取值：
# - development / dev
# - production / prod
# - test
ENV=development
ENVIRONMENT=development


# ==================== 应用基础配置 ====================

API_PREFIX=/api/v1
VERSION=1
DEBUG=True


# ==================== JWT 配置 ====================

# JWT 签名密钥
# 请修改：真实环境不要使用示例值
SECRET_KEY=please_change_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ==================== 数据库配置 ====================

DB_DRIVER=mysql+mysqlconnector
DB_USER=please_change_db_user
DB_PASSWORD=please_change_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=please_change_db_name
DB_CHARSET=utf8mb4
DB_ECHO=True
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30


# ==================== Docker / MySQL 初始化配置 ====================

# 下面四项主要用于 Docker 场景下初始化数据库容器。
# 如果你不使用 Docker 管理数据库，也可以按实际情况调整。
MYSQL_ROOT_PASSWORD=please_change_mysql_root_password
MYSQL_DATABASE=please_change_db_name
MYSQL_USER=please_change_db_user
MYSQL_PASSWORD=please_change_db_password
